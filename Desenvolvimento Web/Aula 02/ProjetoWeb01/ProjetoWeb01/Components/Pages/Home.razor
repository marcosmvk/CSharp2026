@page "/"
@using ProjetoWeb01.Components.Pages.Parciais

<PageTitle>Home</PageTitle>
<CabecalhoPagina/>
<!-- Isso é comentário html-->
<main class="corpo-pagina">
    <div class="login-container">
        <div clas="login-cabecalho">
            <h1 class="login-titulo">Acesso ao WIFI</h1>
            <p class="login-subtitulo">Sistema de gestão WIFI</p>
        </div>
    </div>
    <form class="login-form">
        <div class="form-group">
            <label>E-mail institucional </label>
            <div class="input-w">
                <input type="email" id="email"class="form-input" placeholder="user@Dispatcher.senai.br"/>
            </div>
        </div>
        <div class="form-group">
            <label>Senha</label>
            <div class="input-w">
                <input type="password" id="senha" class="form-input" placeholder="*****"/>
            </div>
          </div>
          <button type="button" id="btn-entrar" class="btn-login">
              Login
           </button>
    </form>
    <div/>
  </main>



<Rodape/>



